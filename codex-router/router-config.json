{
  "listen": {
    "host": "127.0.0.1",
    "port": 10100
  },
  "native": {
    "baseUrl": "https://chatgpt.com/backend-api/codex"
  },
  "routes": [
    {
      "namespace": "deepseek",
      "name": "DeepSeek Official API",
      "baseUrl": "https://api.deepseek.com",
      "timeoutMs": 300000,
      "suppressReasoningContent": true,
      "stabilizeMessagePhase": true,
      "auth": {
        "mode": "bearer_keychain",
        "service": "com.local.codex-native-model-router.deepseek",
        "account": "api-key"
      },
      "models": [
        {
          "id": "deepseek-v4-flash",
          "displayName": "DeepSeek V4 Flash (Official API)",
          "description": "DeepSeek V4 Flash through the official stateless Responses API.",
          "priority": 0,
          "contextWindow": 1048576,
          "defaultReasoningEffort": "high",
          "supportsReasoningSummaries": false,
          "supportsParallelToolCalls": true,
          "reasoningEfforts": [
            "low",
            "high",
            "max"
          ],
          "inputModalities": [
            "text"
          ]
        }
      ]
    },
    {
      "namespace": "qwen",
      "name": "Qwen 3.8 27B (Ollama)",
      "baseUrl": "http://192.168.0.27:11434/v1",
      "timeoutMs": 1200000,
      "wireApi": "chat",
      "keepAlive": "30m",
      "auth": {
        "mode": "none"
      },
      "models": [
        {
          "id": "qwen-3.8-2.7b",
          "upstreamId": "qwen3.8:27b",
          "displayName": "Qwen 3.8 27B",
          "description": "Qwen 3.8 27B through a LAN Ollama OpenAI-compatible Chat Completions endpoint.",
          "contextWindow": 262144,
          "defaultReasoningEffort": "max",
          "supportsReasoningSummaries": false,
          "supportsParallelToolCalls": true,
          "reasoningEfforts": [
            "low",
            "medium",
            "high",
            "max"
          ],
          "inputModalities": [
            "text"
          ]
        }
      ]
    }
  ],
  "configMigration": {
    "defaultModel": "deepseek/deepseek-v4-flash",
    "disableExternalMigration": true,
    "profile": {
      "name": "deepseek",
      "model": "deepseek/deepseek-v4-flash"
    }
  }
}
